<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <XmlWeavePackageVersion Condition="'$(XmlWeavePackageVersion)' == ''">$(Version)</XmlWeavePackageVersion>
    <IsAotCompatible>true</IsAotCompatible>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="XmlWeave" Version="$(XmlWeavePackageVersion)" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="XmlWeave.Tests.cs" />
    <ProjectReference Include="..\XmlWeave\XmlWeave.csproj" />
    <ProjectReference Include="..\XmlWeave.SourceGenerator\XmlWeave.SourceGenerator.csproj" />
